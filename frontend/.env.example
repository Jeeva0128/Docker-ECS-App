# Used by the browser for direct API calls (deprecated for production, kept for local/custom setups)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Used by Next.js server (Vercel) to proxy /api/* requests to the actual backend URL
# Example for production: TASKFLOW_API_URL=http://16.113.163.105:3000
TASKFLOW_API_URL=http://localhost:3000
